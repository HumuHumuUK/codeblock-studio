{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "api": ["api/index.ts"], "api/*": ["api/*"] },
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
